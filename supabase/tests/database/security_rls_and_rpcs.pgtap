-- Follow The Crowd — Security & RLS/RPC pgTAP Tests
-- Tests authorization boundaries for DM conversations and event cancellation.
-- LOCAL-ONLY: Run via `supabase test db` or `pg_prove`.

-- Setup: Create test data in a preamble
BEGIN;

-- Test user IDs (deterministic UUIDs for reproducibility)
-- User 1: aaaaaaaa-aaaa-4aaa-aaaa-aaaaaaaaaaaa
-- User 2: bbbbbbbb-bbbb-4bbb-bbbb-bbbbbbbbbbbb
-- User 3: cccccccc-cccc-4ccc-cccc-cccccccccccc (unrelated third party)

-- Create test conversations and memberships
INSERT INTO public.conversations (id) VALUES
  ('11111111-1111-4111-1111-111111111111'::uuid);

INSERT INTO public.conversation_members (conversation_id, user_id) VALUES
  ('11111111-1111-4111-1111-111111111111'::uuid, 'aaaaaaaa-aaaa-4aaa-aaaa-aaaaaaaaaaaa'::text),
  ('11111111-1111-4111-1111-111111111111'::uuid, 'bbbbbbbb-bbbb-4bbb-bbbb-bbbbbbbbbbbb'::text);

-- Create test messages
INSERT INTO public.messages (id, conversation_id, user_id, text) VALUES
  ('22222222-2222-4222-2222-222222222222'::uuid, '11111111-1111-4111-1111-111111111111'::uuid, 'aaaaaaaa-aaaa-4aaa-aaaa-aaaaaaaaaaaa'::text, 'Test message from User 1');

-- Create test event for cancellation
INSERT INTO public.events (id, owner_id, status) VALUES
  ('33333333-3333-4333-3333-333333333333'::uuid, 'aaaaaaaa-aaaa-4aaa-aaaa-aaaaaaaaaaaa'::text, 'pending');

-- Create booking request linking event to DM conversation
INSERT INTO public.booking_requests (id, event_id, recipient_id, conversation_id, status) VALUES
  ('44444444-4444-4444-4444-444444444444'::uuid, '33333333-3333-4333-3333-333333333333'::uuid, 'bbbbbbbb-bbbb-4bbb-bbbb-bbbbbbbbbbbb'::text, '11111111-1111-4111-1111-111111111111'::uuid, 'pending');

COMMIT;

-- ============================================================================
-- TEST: ANONYMOUS USER CANNOT READ CONVERSATIONS/MESSAGES
-- ============================================================================

BEGIN;
SELECT plan(2);

-- anon role should not exist in test, but test that anonymous queries fail RLS
SELECT throws_ok(
  'SELECT id FROM public.conversations WHERE id = ''11111111-1111-4111-1111-111111111111''::uuid;',
  'P0001',
  'permission denied for schema public',
  'Anonymous user denied SELECT on conversations (RLS)'
);

SELECT throws_ok(
  'SELECT id FROM public.messages WHERE id = ''22222222-2222-4222-2222-222222222222''::uuid;',
  'P0001',
  'permission denied for schema public',
  'Anonymous user denied SELECT on messages (RLS)'
);

SELECT finish();
COMMIT;

-- ============================================================================
-- TEST: AUTHENTICATED NON-MEMBER CANNOT READ CONVERSATION/MESSAGES
-- ============================================================================

BEGIN;
SELECT plan(2);

-- Simulate User 3 (not a member) attempting to read
-- Use SET LOCAL ROLE to switch identity context
SET LOCAL ROLE authenticated;
SET LOCAL app.jwt_claims = '{"sub":"cccccccc-cccc-4ccc-cccc-cccccccccccc"}';

SELECT is(
  (SELECT COUNT(*) FROM public.conversations WHERE id = '11111111-1111-4111-1111-111111111111'::uuid),
  0::bigint,
  'Non-member cannot read conversation (RLS enforced)'
);

SELECT is(
  (SELECT COUNT(*) FROM public.messages WHERE conversation_id = '11111111-1111-4111-1111-111111111111'::uuid),
  0::bigint,
  'Non-member cannot read messages in conversation (RLS enforced)'
);

SELECT finish();
COMMIT;

-- ============================================================================
-- TEST: AUTHENTICATED MEMBER CAN READ CONVERSATION/MESSAGES
-- ============================================================================

BEGIN;
SELECT plan(2);

-- Simulate User 1 (conversation member) attempting to read
SET LOCAL ROLE authenticated;
SET LOCAL app.jwt_claims = '{"sub":"aaaaaaaa-aaaa-4aaa-aaaa-aaaaaaaaaaaa"}';

SELECT is(
  (SELECT COUNT(*) FROM public.conversations WHERE id = '11111111-1111-4111-1111-111111111111'::uuid),
  1::bigint,
  'Member can read conversation (RLS allows)'
);

SELECT is(
  (SELECT COUNT(*) FROM public.messages WHERE conversation_id = '11111111-1111-4111-1111-111111111111'::uuid),
  1::bigint,
  'Member can read their messages (RLS allows)'
);

SELECT finish();
COMMIT;

-- ============================================================================
-- TEST: MESSAGE INSERT REQUIRES MEMBERSHIP AND user_id = auth.uid()
-- ============================================================================

BEGIN;
SELECT plan(3);

SET LOCAL ROLE authenticated;
SET LOCAL app.jwt_claims = '{"sub":"aaaaaaaa-aaaa-4aaa-aaaa-aaaaaaaaaaaa"}';

-- User 1 can insert (is member)
SELECT throws_ok(
  'INSERT INTO public.messages (id, conversation_id, user_id, text) VALUES (''55555555-5555-4555-5555-555555555555''::uuid, ''11111111-1111-4111-1111-111111111111''::uuid, ''aaaaaaaa-aaaa-4aaa-aaaa-aaaaaaaaaaaa''::text, ''Test insert'');',
  '',
  '',
  'Member can insert message as themselves'
);

-- User 1 cannot insert with different user_id
SELECT throws_ok(
  'INSERT INTO public.messages (id, conversation_id, user_id, text) VALUES (''66666666-6666-4666-6666-666666666666''::uuid, ''11111111-1111-4111-1111-111111111111''::uuid, ''bbbbbbbb-bbbb-4bbb-bbbb-bbbbbbbbbbbb''::text, ''Spoofed insert'');',
  'P0001',
  'new row violates row-level security policy',
  'Cannot insert message as different user (RLS blocks user_id mismatch)'
);

-- Non-member cannot insert
SET LOCAL app.jwt_claims = '{"sub":"cccccccc-cccc-4ccc-cccc-cccccccccccc"}';

SELECT throws_ok(
  'INSERT INTO public.messages (id, conversation_id, user_id, text) VALUES (''77777777-7777-4777-7777-777777777777''::uuid, ''11111111-1111-4111-1111-111111111111''::uuid, ''cccccccc-cccc-4ccc-cccc-cccccccccccc''::text, ''Non-member insert'');',
  'P0001',
  'new row violates row-level security policy',
  'Non-member cannot insert message (RLS blocks non-membership)'
);

SELECT finish();
COMMIT;

-- ============================================================================
-- TEST: mark_conversation_unread() HAS NO PUBLIC/anon/authenticated EXECUTE
-- ============================================================================

BEGIN;
SELECT plan(1);

-- Check function grants in information_schema
SELECT is(
  (SELECT COUNT(*) FROM information_schema.role_routine_grants
   WHERE routine_name = 'mark_conversation_unread'
     AND (grantee = 'anon' OR grantee = 'authenticated' OR grantee = 'PUBLIC')),
  0::bigint,
  'mark_conversation_unread() not granted to PUBLIC, anon, or authenticated'
);

SELECT finish();
COMMIT;

-- ============================================================================
-- TEST: cancel_event() IS AUTHENTICATED-ONLY
-- ============================================================================

BEGIN;
SELECT plan(1);

-- Check that cancel_event() is granted only to authenticated
SELECT is(
  (SELECT COUNT(*) FROM information_schema.role_routine_grants
   WHERE routine_name = 'cancel_event'
     AND grantee = 'authenticated'
     AND privilege_type = 'EXECUTE'),
  1::bigint,
  'cancel_event() is granted EXECUTE to authenticated role only'
);

SELECT finish();
COMMIT;

-- ============================================================================
-- TEST: UNAUTHORIZED USER CANNOT CANCEL ANOTHER'S EVENT
-- ============================================================================

BEGIN;
SELECT plan(1);

-- User 2 (not event owner) tries to cancel User 1's event
SET LOCAL ROLE authenticated;
SET LOCAL app.jwt_claims = '{"sub":"bbbbbbbb-bbbb-4bbb-bbbb-bbbbbbbbbbbb"}';

SELECT throws_ok(
  'SELECT public.cancel_event(''33333333-3333-4333-3333-333333333333''::uuid);',
  'P0001',
  'Event not found or not allowed',
  'Non-owner cannot cancel event (authorization check enforced)'
);

SELECT finish();
COMMIT;

-- ============================================================================
-- TEST: AUTHORIZED EVENT OWNER CAN CANCEL EVENT
-- ============================================================================

BEGIN;
SELECT plan(2);

-- User 1 (event owner) cancels their own event
SET LOCAL ROLE authenticated;
SET LOCAL app.jwt_claims = '{"sub":"aaaaaaaa-aaaa-4aaa-aaaa-aaaaaaaaaaaa"}';

SELECT throws_ok(
  'SELECT public.cancel_event(''33333333-3333-4333-3333-333333333333''::uuid);',
  '',
  '',
  'Event owner can cancel their event'
);

-- Verify event status changed to 'cancelled'
SELECT is(
  (SELECT status FROM public.events WHERE id = '33333333-3333-4333-3333-333333333333'::uuid),
  'cancelled'::text,
  'Event status updated to cancelled'
);

SELECT finish();
COMMIT;

-- ============================================================================
-- TEST: Client cannot invoke mark_conversation_unread() directly
-- ============================================================================

BEGIN;
SELECT plan(1);

SET LOCAL ROLE authenticated;
SET LOCAL app.jwt_claims = '{"sub":"aaaaaaaa-aaaa-4aaa-aaaa-aaaaaaaaaaaa"}';

-- Even authenticated user cannot call the function directly
SELECT throws_ok(
  'SELECT public.mark_conversation_unread(''bbbbbbbb-bbbb-4bbb-bbbb-bbbbbbbbbbbb''::text, ''11111111-1111-4111-1111-111111111111''::uuid, NULL::uuid);',
  'P0001',
  'permission denied for function mark_conversation_unread',
  'Client role denied EXECUTE on mark_conversation_unread (internal function only)'
);

SELECT finish();
COMMIT;
