# Copy to .env.local and fill in values. Never commit .env.local.
# See docs/handoff/SECRETS.md for where each value lives (Vercel, Supabase, etc.).

# --- App URL (recommended for production auth redirects) ---
# Public site origin used for Supabase password-reset and other auth redirectTo URLs.
# Set on Vercel to your canonical production domain, e.g. https://followthecrowd.com.au
NEXT_PUBLIC_APP_URL=https://followthecrowd.com.au

# --- Support (private beta) ---
# Personal inbox for Settings → Request account deletion mailto links.
NEXT_PUBLIC_SUPPORT_EMAIL=your-email@example.com

# --- Supabase (required) ---
# Public keys are exposed to the browser; security relies on RLS, not hiding the anon key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only (required for event-plan API) ---
OPENAI_API_KEY=

# --- Google Maps (optional; venue map in UI) ---
# Restrict by HTTP referrer in Google Cloud Console for production domains.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- FTC Agent Room (internal developer tool; local development only) ---
# Off unless this is exactly "true". Also refused outright when running on
# Vercel, so setting it there does nothing. Never enable it in production.
FTC_AGENT_ROOM_ENABLED=false
# Server-only. Never exposed to the browser; all model calls run server-side.
ANTHROPIC_API_KEY=
# Provider models. Leave blank to use the defaults in lib/agentRoom/config.ts
# (claude-opus-5 and gpt-4o). Set the OpenAI one to your preferred reviewer model.
FTC_AGENT_ROOM_ANTHROPIC_MODEL=
FTC_AGENT_ROOM_OPENAI_MODEL=
# Optional. Fill these in to get a dollar estimate for the OpenAI half; without
# them the Agent Room shows token counts and no cost rather than a guess.
FTC_AGENT_ROOM_OPENAI_INPUT_USD_PER_MTOK=
FTC_AGENT_ROOM_OPENAI_OUTPUT_USD_PER_MTOK=

# --- Local scripts only (optional; not used by Next.js runtime) ---
# GOOGLE_PLACES_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # bypasses RLS — local diagnostics only; do not add to Vercel unless required
