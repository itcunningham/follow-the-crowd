# Synthetic QA account credentials for authenticated production Playwright runs.
# Copy this file to `.env.qa.local` and fill with dedicated QA test accounts only.
# Never commit `.env.qa.local`.

FTC_QA_PLANNER_EMAIL=
FTC_QA_PLANNER_PASSWORD=
FTC_QA_DJ_EMAIL=
FTC_QA_DJ_PASSWORD=
FTC_QA_BOTH_EMAIL=
FTC_QA_BOTH_PASSWORD=

# Optional extra DJ accounts for beta QA (used by resetQaEnvironment / npm qa:reset-environment)
# FTC_QA_DJ1_EMAIL=
# FTC_QA_DJ1_PASSWORD=
# FTC_QA_DJ2_EMAIL=
# FTC_QA_DJ2_PASSWORD=
# FTC_QA_DJ3_EMAIL=
# FTC_QA_DJ3_PASSWORD=

# Optional override (defaults to production):
# FTC_QA_BASE_URL=https://follow-the-crowd.vercel.app
